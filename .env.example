# ──────────────────────────────────────────────
# REQUIRED — You must change these values
# ──────────────────────────────────────────────

# Database password — generate with: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# Odoo master password (for creating/managing databases)
# Generate with: openssl rand -base64 24
ODOO_ADMIN_PASSWORD=CHANGE_ME

# ──────────────────────────────────────────────
# DOMAIN — Leave empty for local/IP access
# ──────────────────────────────────────────────
# If you have a domain name, set it here (no www, no https):
#   DOMAIN=ephem.health.gov.ye
# If you don't have a domain (local VM, testing, personal machine):
#   Leave it empty — the system will be accessible via http://YOUR_IP
DOMAIN=

# Email for SSL certificate (only needed if DOMAIN is set)
SSL_EMAIL=

# ──────────────────────────────────────────────
# OPTIONAL — Defaults work for most setups
# ──────────────────────────────────────────────

POSTGRES_USER=odoo
POSTGRES_DB=postgres

# App image version. PRODUCTION SERVERS: pin a release so `docker compose pull`
# never jumps versions silently (see published tags on hub.docker.com/r/borrs/ephem):
#   EPHEM_IMAGE_TAG=1.0.2
# Leave empty for local dev/demo (= latest). To upgrade a pinned server, change
# the version here, then: docker compose pull && docker compose up -d
EPHEM_IMAGE_TAG=

# Set to False after creating all your databases — this disables the public
# database manager (/web/database/manager), which can otherwise create, drop
# and download databases protected only by the master password.
# setup.sh (server mode) offers to do this automatically once databases exist.
ODOO_LIST_DB=True

# Multi-tenant routing: which database serves which domain.
# For subdomain = database name (training.health.gov.xx → database "training"),
# set:
#   ODOO_DBFILTER=^%d$
# %d becomes the FIRST label of the requested domain ("training"); the ^ and $
# make the match exact, so database "train" can never answer for "training".
# Leave empty on a single-database server. Apply changes with: bash setup.sh
ODOO_DBFILTER=

# ──────────────────────────────────────────────
# BACKUPS (scripts/backup.sh) — production servers should set the first two
# ──────────────────────────────────────────────

# Encrypt backups (STRONGLY recommended — dumps contain health data).
# On your ADMIN machine (NOT the server) run:  age-keygen -o ephem-backup-key.txt
# Paste the printed public "age1..." key here. Keep the private key file in a
# vault, off the server — it is the only thing that can decrypt the backups.
BACKUP_AGE_RECIPIENT=

# Dead-man's-switch monitoring: this URL is pinged after each successful
# backup (healthchecks.io / Uptime Kuma). The monitor alerts you when
# backups STOP arriving — quiet failure is how backups are usually lost.
BACKUP_PING_URL=

# Days of local backup retention (default 14). Applies to scripts/backup.sh
# only — the per-database snapshot folders are kept by count, below.
BACKUP_KEEP_DAYS=

# How many per-database snapshots (manage.sh -> Advanced -> Databases ->
# Backup) to keep for EACH database; older ones are pruned after every new
# snapshot. Default 10, 0 disables pruning.
SNAPSHOT_KEEP=

# Optional: separate password for the 'postgres' maintenance superuser.
# Defaults to POSTGRES_PASSWORD. Generate with: openssl rand -base64 24
POSTGRES_ADMIN_PASSWORD=

# Max upload size through nginx (default 100M). Uploads above it fail with
# '413 Request Entity Too Large' — raise it to restore big databases through
# the database manager. Change it via:  bash manage.sh  → 10
NGINX_MAX_UPLOAD=

# Who may call the RPC endpoints (/xmlrpc, /jsonrpc). They take a password
# with no login page, no CSRF and no second factor, and the web client never
# uses them, so they stay blocked unless an external system has to call in.
# Empty = blocked for everyone (default). Otherwise:
#   NGINX_RPC_ALLOW=203.0.113.55 10.20.0.0/16    only these addresses / ranges
#   NGINX_RPC_ALLOW=all                          everyone (not recommended)
# Change it via:  bash manage.sh  → 11) Advanced → 4) RPC endpoints
NGINX_RPC_ALLOW=

# Domains whose RPC endpoints are open to everyone, whatever the default
# above says (each domain has its own nginx server block, so this is per
# tenant; on an HTTP-only server only the default applies). Open a tenant
# while an integration or import has to call in, then block it again.
#   NGINX_RPC_OPEN=training.pheoc.com simex.pheoc.com
# Change it via:  bash manage.sh  → 11) Advanced → 4) RPC endpoints
NGINX_RPC_OPEN=
