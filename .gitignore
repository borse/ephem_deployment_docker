# Passwords
.env

# age private keys. The README tells you to generate ephem-backup-key.txt;
# it decrypts every backup this server has ever written, so it belongs in a
# vault, not in Git and ideally not on the server at all.
*-key.txt
*.age.key
ephem-backup-key.txt

# Data (lives on the server, not in Git)
postgres-data/
odoo-data/
# whole directory: dumps, encrypted .age snapshots, migration dirs, logs —
# all of it is health data or derived from it, none of it belongs in Git
backups/
# module update logs written by scripts/update-modules.sh (auto-created)
logs/
# local basemap files (bash manage.sh: Local basemap), downloaded per server
basemaps/
.env
addons/
custom-addons/
odoo.conf

# NGINX HTTP-only backup (created by ssl-setup.sh)
nginx/active.conf
nginx/active.conf.bak
# proxy mode: the config written for the nginx on the proxy machine (addresses)
nginx/proxy/
nginx/default.http-only.conf

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
/docker-compose.override.yml

# Claude Code — all local Claude data (skills, settings, state) is machine-local
# and contains local ports/creds/paths; never commit any of it.
.claude/

# Stray sandbox/agent output — never belongs in the repo
/mnt/

# Multi-instance dev mode (scripts/dev-instances.sh)
/docker-compose.dev-multi.yml
/.dev-instances
custom-addons-*/
odca*/
odca1/
odca2/
odca3/
odoo-*.conf


/nginx.conf

# local documentation artifacts (handbook PDFs, presentation decks)
docs/
/tools/new_18_auto_update.sh
.gitignore
/scratch/
